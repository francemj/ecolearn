OPENAI_API_KEY=your-openai-key-here
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=your-secret-for-cron-auth

# Postgres. Optional: with no DATABASE_URL the app still serves today's article
# from Redis, it just keeps no permanent archive.
#
# Point at PgBouncer (transaction mode), not Postgres directly — the app runs as
# serverless functions and would otherwise exhaust the connection limit. Use
# sslmode=verify-full against anything remote.
DATABASE_URL=postgresql://user:password@host:6432/ecolearn?sslmode=verify-full
